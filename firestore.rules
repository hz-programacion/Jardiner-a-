rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // Collection: workspaces/{userId}
    // Document ID: {userId} (matches request.auth.uid)
    // Required fields: ownerUid, properties, todayJobs, invoices, expenses, equipment
    // Optional fields: ownerEmail, updatedAtIso, updatedAt, registeredAt,
    //                  isApproved, approvalStatus, role,
    //                  businessProfile, baseLocation, paymentProfile, subscription, license
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        request.auth.token.email == "hz.mdiego@gmail.com";
    }

    function isValidWorkspace(data, userId) {
      return data.keys().hasAll(['ownerUid', 'properties', 'todayJobs', 'invoices', 'expenses', 'equipment']) &&
        data.keys().hasOnly([
          'ownerUid',
          'ownerEmail',
          'updatedAtIso',
          'updatedAt',
          'registeredAt',
          'isApproved',
          'approvalStatus',
          'role',
          'businessProfile',
          'baseLocation',
          'paymentProfile',
          'subscription',
          'license',
          'properties',
          'todayJobs',
          'invoices',
          'expenses',
          'equipment'
        ]) &&
        data.ownerUid is string &&
        data.ownerUid == userId &&
        (!('isApproved' in data) || data.isApproved is bool) &&
        (!('approvalStatus' in data) || data.approvalStatus in ['pending', 'approved', 'revoked']) &&
        (!('role' in data) || data.role in ['admin', 'user']) &&
        data.properties is list && data.properties.size() <= 500 &&
        data.todayJobs is list && data.todayJobs.size() <= 1000 &&
        data.invoices is list && data.invoices.size() <= 1000 &&
        data.expenses is list && data.expenses.size() <= 1000 &&
        data.equipment is list && data.equipment.size() <= 200;
    }

    function cannotSelfApproveOnCreate(data) {
      return (!('isApproved' in data) || data.isApproved == false) &&
        (!('approvalStatus' in data) || data.approvalStatus == 'pending') &&
        (!('role' in data) || data.role == 'user');
    }

    function approvalFieldsUnchanged(newData, oldData) {
      return newData.get('isApproved', false) == oldData.get('isApproved', false) &&
        newData.get('approvalStatus', 'pending') == oldData.get('approvalStatus', 'pending') &&
        newData.get('role', 'user') == oldData.get('role', 'user');
    }

    match /workspaces/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin() || (isAuthenticated() && resource.data.ownerUid == request.auth.uid);

      allow create: if isValidId(userId) && (
        isAdmin() ||
        (isOwner(userId) && cannotSelfApproveOnCreate(request.resource.data))
      );

      allow update: if isValidId(userId) && (
        isAdmin() ||
        (isOwner(userId) &&
          request.resource.data.ownerUid == resource.data.ownerUid &&
          approvalFieldsUnchanged(request.resource.data, resource.data))
      );

      allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());
    }

    match /access_requests/{requestId} {
      allow get: if isValidId(requestId) && (isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid));
      allow list: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow create: if isValidId(requestId) && isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

